{
  "name": "runtime-broker",
  "version": "10.0.26100.1",
  "description": "Runtime Broker",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeep2421-hub/study-ai-assistant.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npm run build && node start_stealth.js",
    "start": "node start_stealth.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@vitejs/plugin-react": "^4.2.0",
    "clipboard": "^2.0.0",
    "firebase": "^10.7.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.20.0",
    "os": "^0.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "screenshot-desktop": "^1.12.7",
    "tesseract.js": "^5.0.4",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "keywords": [
    "electron",
    "ai",
    "study",
    "assistant"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "build": {
    "appId": "Microsoft.Windows.RuntimeBroker",
    "productName": "Microsoft® Windows® Operating System",
    "copyright": "© Microsoft Corporation. All rights reserved.",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "executableName": "RuntimeBroker",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Microsoft® is a registered trademark of Microsoft Corporation."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "System Helper"
    },
    "mac": {
      "target": "dmg",
      "executableName": "SystemPreferencesHelper",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": "AppImage",
      "executableName": "gnome-settings-daemon",
      "category": "Utility",
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "System Settings Helper",
        "Comment": "System configuration utility",
        "Categories": "Utility;System;"
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "auth.html",
      "update.html",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*"
    ],
    "compression": "normal",
    "nodeGypRebuild": false,
    "npmRebuild": true,
    "publish": null
  }
}
